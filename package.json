{
  "name": "fatewheel",
  "productName": "Destiny Unbound",
  "version": "0.1.0-alpha.1",
  "description": "Spin-the-wheel fantasy character generator with buffs, debuffs, arena fights and optional AI portraits.",
  "license": "GPL-3.0-or-later",
  "author": "Destiny Unbound contributors",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/engine.test.js && node tests/art.test.js && node tests/story.test.js && node tests/extras.test.js && node tests/mods.test.js && node tests/system.test.js",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run icons && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run icons && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run icons && electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "io.github.fatewheel.app",
    "productName": "Destiny Unbound",
    "copyright": "Destiny Unbound contributors, GPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "app/**",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "DestinyUnbound-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DestinyUnbound-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        "AppImage"
      ]
    },
    "dmg": {
      "artifactName": "DestinyUnbound-${version}-mac-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "DestinyUnbound-${version}-linux.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ScikuVRC",
        "repo": "destiny-unbound",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/bzrkherja"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
